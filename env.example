MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/subhlaxmi
MONGODB_DB=subhlaxmi
AUTH_SECRET=replace-with-a-long-random-secret

# Optional. Without SMTP in local development, the register API returns a devCode.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=Subhlaxmi <no-reply@example.com>
